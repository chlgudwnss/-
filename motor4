// 모터 드라이버 핀 정의
const int IN1 = 10;   // L298N IN1
const int IN2 = 11;   // L298N IN2
const int ENA = 9;   // L298N ENA (PWM 핀)

// 설정
void setup() {
  // 출력으로 설정
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(ENA, OUTPUT);

  // 모터 앞으로 회전
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  analogWrite(ENA, 200);  // 속도 (0~255)
}

void loop() {
  // 계속 회전
}
