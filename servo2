#include <Servo.h>

Servo myServo;

const int SERVO_PIN = 5;       // 서보 신호 핀
const int SERVO_MIN = 30;      // 최소 제한 각도
const int SERVO_MAX = 150;     // 최대 제한 각도
const int SERVO_CENTER = 90;   // 중립 위치

void setup() {
  myServo.attach(SERVO_PIN);

  // 🔹 Step 1: 왼쪽 (최소값)으로 이동
  setServoAngle(SERVO_MIN);
  delay(1000);  // 1초 대기

  // 🔹 Step 2: 오른쪽 (최대값)으로 이동
  setServoAngle(SERVO_MAX);
  delay(1000);  // 1초 대기

  // 🔹 Step 3: 중립 위치로 돌아오기
  setServoAngle(SERVO_CENTER);
  delay(1000);  // 1초 대기
}

void loop() {
  // 반복 동작 없음
}

// 리미트가 적용된 서보 제어 함수
void setServoAngle(int angle) {
  angle = constrain(angle, SERVO_MIN, SERVO_MAX);  // 각도 제한
  myServo.write(angle);                            // 서보 회전
}
