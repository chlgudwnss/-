#include <NewPing.h>

// 초음파 센서 6개, 핀 22~33 사용
NewPing sonar[6] = {
  NewPing(22, 23, 200), // Front 1
  NewPing(26, 27, 200), // Front 2
  NewPing(30, 31, 200), // Left 1
  NewPing(34, 35, 200), // Left 2
  NewPing(38, 39, 200), // Right 1
  NewPing(42, 43 , 200)  // Right 2
};

// 센서 위치 이름 배열
const char* sensorNames[6] = {
  "Front 1",
  "Front 2",
  "Left 1",
  "Left 2",
  "Right 1",
  "Right 2"
};

void setup() {
  Serial.begin(115200);
}

void loop() {
  for (int i = 0; i < 6; i++) {
    delay(50);
    Serial.print(sensorNames[i]);
    Serial.print(": ");
    Serial.print(sonar[i].ping_cm());
    Serial.println(" cm");
  }
  Serial.println();
  delay(500);
}

